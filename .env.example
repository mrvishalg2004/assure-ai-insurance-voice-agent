# ==============================================================================
# ASSUREAI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your own credentials:
# cp .env.example .env.local

# Server Port (Express REST API)
PORT=5001

# Application URLs (for CORS and client-side API requests)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5001

# MongoDB Connection String (Local daemon or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/assure-ai

# JWT Secret for stateless user authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Bolna.ai Voice Telephony Credentials
# Register and configure your agent at: https://bolna.dev
BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Telephony Mock Mode (Optional for testing)
# Set to 'true' to simulate outbound voice calls and test telemetry without spending credits
MOCK_BOLNA_CALLS=false

# Generative AI & Advisory Chatbot Configuration
# OpenRouter API (Primary multi-model provider for insurance advisory chat)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google AI Studio API Key (for Gemini 2.0 Flash Genkit flows)
GOOGLE_API_KEY=your_google_api_key_here
